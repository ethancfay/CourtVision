# Copy to backend/.env for local runs. Never commit the real .env.
# AI (chat, scouting reports, take verdicts) - free key at console.groq.com
GROQ_API_KEY=
# Live NBA games - free key at balldontlie.io
BALLDONTLIE_API_KEY=
# Supabase project URL and service_role key (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional Redis cache (Upstash). Leave empty to use in-memory cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Any long random string; needed to call /api/admin/* routes
ADMIN_TOKEN=
MODEL_PATH=app/ml/artifacts/courtiq_model.pkl
MODEL_SCALER_PATH=app/ml/artifacts/scaler.pkl
MODEL_FEATURES_PATH=app/ml/artifacts/feature_names.json
USE_ML_MODEL=true
ENABLE_SCHEDULER=true
INGEST_HOUR_UTC=8
ENVIRONMENT=production
NBA_API_DELAY=0.7
